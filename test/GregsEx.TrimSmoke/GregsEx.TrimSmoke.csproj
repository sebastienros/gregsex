<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../src/GregsEx/buildTransitive/GregsEx.targets" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/GregsEx/GregsEx.csproj" />
    <Compile Include="../GregsEx.AotSmoke/UnicodeVersionSmoke.cs" Link="UnicodeVersionSmoke.cs" />
    <Analyzer Include="../../src/GregsEx.Generator/bin/$(Configuration)/netstandard2.0/GregsEx.Generator.dll" />
  </ItemGroup>

  <Target Name="EnsureGeneratorBuilt" BeforeTargets="ResolveReferences;CoreCompile">
    <MSBuild Projects="../../src/GregsEx.Generator/GregsEx.Generator.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="PublishAot;PublishTrimmed;PublishSingleFile;SelfContained;RuntimeIdentifier;TargetFramework;OutputPath;OutDir;PublishDir" />
  </Target>
</Project>

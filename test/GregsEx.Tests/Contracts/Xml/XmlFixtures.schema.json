{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "XmlFixtures.schema.json",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "xml-fixtures-1"
    },
    "dataId": {
      "const": "Unicode-16.0.0+XML-1.0-5e"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "required": [
    "contractVersion",
    "dataId",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "index",
        "length"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "participated": {
          "type": "boolean"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "participated",
        "index",
        "length"
      ],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "range": {
          "$ref": "#/$defs/range"
        },
        "captures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/capture"
          }
        }
      },
      "required": [
        "range",
        "captures"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "parentIndex": {
          "type": "integer",
          "minimum": -1
        },
        "groupNumber": {
          "type": "integer",
          "minimum": 0
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      },
      "required": [
        "kind",
        "parentIndex",
        "groupNumber",
        "range"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "location": {
          "enum": [
            "Pattern",
            "Flags",
            "Replacement",
            "Input",
            "Host"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "offsetUnit": {
          "enum": [
            "Utf16CodeUnits",
            "Bytes"
          ]
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "location",
        "offset",
        "length",
        "offsetUnit",
        "namespace"
      ],
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ParseSuccess",
            "InvalidSyntax",
            "Match",
            "NoMatch",
            "FunctionError",
            "InvalidInput",
            "UnsupportedRepresentation",
            "DestinationTooSmall",
            "LimitExceeded",
            "Cancelled",
            "TimedOut",
            "HostLimitExceeded"
          ]
        },
        "boolean": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/match"
          }
        },
        "texts": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "tree": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "boolean",
        "matches",
        "texts",
        "tree",
        "error"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "Specification",
            "GregsExInterpretation",
            "Imported",
            "Discovery"
          ]
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "clause": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "oracleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "uri",
        "clause",
        "license",
        "oracleId"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxWork": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "maxCompileWork": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "frameCapacity": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "maxResults": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "maxOutputUnits": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "maxHostMemoryBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cancelled": {
          "type": "boolean"
        }
      },
      "required": [
        "maxWork",
        "maxCompileWork",
        "frameCapacity",
        "maxResults",
        "maxOutputUnits",
        "maxHostMemoryBytes",
        "cancelled"
      ],
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "enum": [
            "Xsd11",
            "XPath31"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(XS-(00[1-9]|01[0-2])|XP-(00[1-9]|01[0-7]))$"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "patternKind": {
          "enum": [
            "Utf16",
            "Bytes"
          ]
        },
        "patternUnits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "inputKind": {
          "enum": [
            "Utf16",
            "Utf8",
            "Bytes"
          ]
        },
        "inputUnits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "absentInput": {
          "type": "boolean"
        },
        "flags": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "Parse",
            "Membership",
            "Find",
            "FindCaptures",
            "Matches",
            "Replace",
            "Tokenize",
            "TokenizeOne",
            "AnalyzeString"
          ]
        },
        "startAt": {
          "type": "integer",
          "minimum": 0
        },
        "destinationLength": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "replacementUnits": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/limits"
            },
            {
              "type": "null"
            }
          ]
        },
        "permitted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/expected"
          }
        }
      },
      "required": [
        "id",
        "profileId",
        "capabilities",
        "provenance",
        "patternKind",
        "patternUnits",
        "inputKind",
        "inputUnits",
        "absentInput",
        "flags",
        "operation",
        "startAt",
        "destinationLength",
        "replacementUnits",
        "limits",
        "permitted"
      ],
      "additionalProperties": false
    }
  }
}

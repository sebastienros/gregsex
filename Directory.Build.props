<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
  <!-- Every assembly is strong-named with the repository key, so .NET Framework hosts that load strong-named
       consumers (TextMateSharp) can load GregsEx, and the friend assemblies below can see its internals. The key pair
       is public on purpose: strong names give identity, not security. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)GregsEx.snk</AssemblyOriginatorKeyFile>
    <GregsExPublicKey></GregsExPublicKey>
  </PropertyGroup>
  <!-- A test build bound to a non-default GregsEx asset keeps its own obj/bin so it never mixes with the net10.0 build. -->
  <PropertyGroup Condition="'$(GregsExTargetFramework)' != '' and '$(MSBuildProjectName)' == 'GregsEx.Tests'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/GregsEx.Tests-$(GregsExTargetFramework)/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/GregsEx.Tests-$(GregsExTargetFramework)/bin/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GregsExTargetFramework)' == 'netstandard2.0' and '$(MSBuildProjectName)' == 'GregsEx.Tests'">
    <DefineConstants>$(DefineConstants);GREGSEX_NETSTANDARD_ASSET</DefineConstants>
  </PropertyGroup>
</Project>

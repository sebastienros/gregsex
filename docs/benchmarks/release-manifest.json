{
  "schema_version": "1.0",
  "scope": "Deterministic cases, cohorts, comparators, host conditions, and baseline-derived promotion thresholds. Compare equivalent BenchmarkDotNet operations only.",
  "contract_revision": "docs/specs/acceleration.md",
  "corpus": {
    "determinism": "Every input is regenerated by benchmarks/GregsEx.Benchmarks/Acceleration/Corpus from generator+seed+length+inject; every engine runs the same generated text inside BenchmarkDotNet cases.",
    "materialization": "Benchmark setup regenerates each input in memory from its deterministic case definition; no materialized input files are required.",
    "generators": {
      "prose-v1": "Seeded SplitMix64 picks words from a fixed 64-word lowercase ASCII vocabulary; every 12th word is followed by a newline, otherwise a space. inject places literal strings at given fractions of the length.",
      "log-v1": "Seeded lines '<yyyy>-<mm>-<dd> <hh>:<mm>:<ss> <LEVEL> user=<name> id=<n> msg=<word>' separated by LF.",
      "repeat-v1": "The given text repeated to length; a suffix is appended when 'suffix' is present.",
      "unicode-mixed-v1": "prose-v1 where every 5th word is drawn from fixed Cyrillic, Greek and CJK vocabularies."
    },
    "sizes": {
      "small": 64,
      "medium": 4096,
      "large": 1048576,
      "default": 65536
    }
  },
  "cohorts": [
    {
      "id": "core",
      "profile": "RegularCore",
      "input": [
        "Utf16",
        "Bytes"
      ],
      "comparators": [
        "bcl-interpreted",
        "bcl-compiled",
        "bcl-sourcegen"
      ]
    },
    {
      "id": "ecmascript",
      "profile": "ECMAScript",
      "input": [
        "Utf16"
      ],
      "comparators": [
        "bcl-interpreted",
        "bcl-compiled",
        "bcl-sourcegen",
        "bcl-ecma-interpreted",
        "bcl-ecma-compiled",
        "jint-quickjs"
      ]
    },
    {
      "id": "posix",
      "profile": "POSIX",
      "input": [
        "Bytes"
      ],
      "comparators": [
        "bcl-interpreted",
        "bcl-compiled",
        "bcl-sourcegen"
      ]
    },
    {
      "id": "pcre2",
      "profile": "PCRE2",
      "input": [
        "Utf16",
        "Bytes"
      ],
      "comparators": [
        "bcl-interpreted",
        "bcl-compiled",
        "bcl-sourcegen"
      ]
    }
  ],
  "comparators": [
    {
      "id": "bcl-interpreted",
      "engine": "System.Text.RegularExpressions",
      "options": "RegexOptions.None",
      "kind": "in-process"
    },
    {
      "id": "bcl-compiled",
      "engine": "System.Text.RegularExpressions",
      "options": "RegexOptions.Compiled",
      "kind": "in-process"
    },
    {
      "id": "bcl-sourcegen",
      "engine": "System.Text.RegularExpressions",
      "options": "[GeneratedRegex]",
      "kind": "in-process"
    },
    {
      "id": "bcl-ecma-interpreted",
      "engine": "System.Text.RegularExpressions",
      "options": "RegexOptions.ECMAScript",
      "kind": "in-process"
    },
    {
      "id": "bcl-ecma-compiled",
      "engine": "System.Text.RegularExpressions",
      "options": "RegexOptions.ECMAScript | RegexOptions.Compiled",
      "kind": "in-process"
    },
    {
      "id": "jint-quickjs",
      "engine": "Jint.Runtime.RegExp (QuickJS libregexp port) compiled in-process, custom engine forced",
      "source": "sebastienros/jint Jint/Runtime/RegExp; compiled in through the JINT_QUICKJS define",
      "kind": "in-process"
    }
  ],
  "operations": [
    "is_match",
    "find",
    "count",
    "captures"
  ],
  "cases": [
    {
      "id": "lit-rare-64k",
      "category": "literal",
      "pattern": "Sherlock Holmes",
      "profiles": [
        "RegularCore",
        "ECMAScript",
        "POSIX",
        "PCRE2"
      ],
      "operations": [
        "is_match",
        "find"
      ],
      "input": {
        "generator": "prose-v1",
        "seed": 1,
        "length": 65536,
        "inject": [
          {
            "text": "Sherlock Holmes",
            "at": 0.9
          }
        ]
      }
    },

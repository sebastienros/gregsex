  "host_policy": {
    "local_rid": "osx-arm64",
    "reference_host": "Apple M4 Pro arm64, macOS, AC power; recorded per run, never assumed idle",
    "other_rids": "win-x64, linux-x64 and linux-arm64 timing is not measured locally; their obligations remain evidence gaps, not support or speed claims",
    "runner": "BenchmarkDotNet 0.15.8 with [MemoryDiagnoser] and [ShortRunJob]; every comparator is an in-process BenchmarkDotNet case sharing the same corpus, warm-up and iteration policy",
    "repetitions": "at least 3 independent runs per promoted candidate; per-case relative noise is the largest StdDev/Mean over the baseline runs",
    "metadata": "Retain dotnet --info, BDN version, code revision, comparator versions and commands, input identities, host load and power with raw artifacts outside Git.",
    "measurement": "Prepare and build before a bounded measurement sequence; record actual host load, power, and thermal conditions. Do not assume an idle host."
  },
  "thresholds": {
    "win_ratio": 0.9,
    "regression_ratio": 1.05,
    "noise_multiplier": 2.0,
    "rule": "ratio = candidate median / reference median on the same case. Effective win limit = min(win_ratio, 1 - noise_multiplier * noise); effective regression limit = max(regression_ratio, 1 + noise_multiplier * noise), with noise taken from the baseline repetitions. A candidate is promoted only when it wins at least one pinned case in its category and regresses none outside a guard that routes that case to the reference. Everything else is informational.",
    "allocation": "BDN MemoryDiagnoser B/op for warmed workspace operations must not exceed the reference for the same case; retained plan bytes growth must fit the plan budget. Controlled allocations are acceptable and zero is not chased (PERF-003).",
    "limits": "Work, time, cancellation, capacity and invalid-input statuses must match the reference or be strictly more successful: a limit may become a success only because accelerated work charging is lower, never a NoMatch.",
    "baseline_noise": null
  },
  "promotion": {
    "informational_until": "baseline_noise is measured and recorded with the baseline artifacts",
    "forbidden_claims": [
      "universally fastest",
      "faster than any engine without a same-case BenchmarkDotNet measurement",
      "speedups from an unmeasured candidate"
    ],
    "required_reporting": "wins and regressions for every candidate, throughput (MB/s or ops/s), B/op, retained bytes, comparator versions and commands"
  }
}

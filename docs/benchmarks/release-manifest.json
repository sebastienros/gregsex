        "generator": "repeat-v1",
        "text": "a",
        "length": 26
      },
      "limit_expectation": "backtracking engines may hit the per-operation cap; the cap outcome is reported, never counted as a win"
    },
    {
      "id": "bt-overlap-alt",
      "category": "backtracking-prone",
      "pattern": "(a|aa)+$",
      "profiles": [
